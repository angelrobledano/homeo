<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base dark application theme -->
    <style name="Theme.SaludPersonal" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
    </style>

    <!-- Splash Screen theme using androidx.core.splashscreen -->
    <style name="Theme.SaludPersonal.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.SaludPersonal</item>
    </style>
</resources>
